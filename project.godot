; Engine configuration file.
config_version=5

[application]

config/name="OpenHole"
config/description="Open source hole-eating city game"
config/version="0.1.1"
config/icon="res://icon.svg"
boot_splash/show_image=true
boot_splash/image="res://assets/splash.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.0705882, 0.0588235, 0.109804, 1)
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/quit_on_go_back=false

[autoload]

Save="*res://scripts/autoload/save.gd"
GameState="*res://scripts/autoload/game_state.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.uk.translation")
locale/fallback="en"

[layer_names]

3d_physics/layer_1="ground"
3d_physics/layer_2="edible"
3d_physics/layer_3="well"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
jolt_physics_3d/simulation/baumgarte_stabilization_factor=0.1

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=2
